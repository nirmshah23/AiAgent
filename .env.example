# URL-safe password (letters and digits); never commit .env.
POSTGRES_PASSWORD=replaceWithRandomLocalPassword
ALLOWED_ORIGINS=http://localhost:8080
# The default demo speaks synthetic claim results; it never contacts an insurer.
DIALOG_ENABLED=true
MAX_VOICE_SESSIONS=2
# FP32 baseline: stock dynamic INT8 missed fields in the local smoke comparison.
GLINER_QUANTIZE=false
DIALOG_API_MODE=simulated
BUSINESS_API_ENDPOINTS={}
BUSINESS_API_HEADERS={}
