# Never commit .env. Percent-encode reserved characters in URL passwords.
DATABASE_URL=postgresql+psycopg://voice:REPLACE_ME@127.0.0.1:5432/voice
ALLOWED_ORIGINS=http://localhost:4200
# Relative paths resolve against the repository root through the native launcher.
PARAKEET_MODEL_PATH=models/parakeet-tdt-0.6b-v3
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx
LAYA_MODEL_PATH=models/laya
GLINER_MODEL_PATH=models/gliner-small-v2.1
SESSION_DEBUG_DIR=session-debug
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# The default demo speaks synthetic claim results; it never contacts an insurer.
DIALOG_ENABLED=true
MAX_VOICE_SESSIONS=2
# Speech recognition: parakeet or vosk. Restart after changing.
STT_PROVIDER=parakeet
STT_CPU_THREADS=4
# Optional Intel acceleration: install apps/backend/requirements-openvino.txt first.
PARAKEET_BACKEND=cpu
PARAKEET_OPENVINO_DEVICE=GPU
PARAKEET_OPENVINO_PRECISION=FP32
# FP32 baseline: stock dynamic INT8 missed fields in the local smoke comparison.
GLINER_QUANTIZE=false
DIALOG_API_MODE=simulated
BUSINESS_API_ENDPOINTS={}
BUSINESS_API_HEADERS={}
# Piper duration multiplier: larger values speak more slowly.
PIPER_LENGTH_SCALE=1.3

# Latest-session local testing capture; false disables new recordings.
SESSION_DEBUG_ENABLED=true
